rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public reels: allow anyone to view and post reels so videos sync across all devices
    match /reels/{reelId} {
      allow read: if true;
      allow create: if request.resource.data.id != null && request.resource.data.videoUrl != null;
      allow update: if true;
      allow delete: if true;

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // User accounts and profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
